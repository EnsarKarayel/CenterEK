// Deploy internally first. Publish only after auth/readiness checks.
targetScope = 'resourceGroup'

param location string
param prefix string = 'centerek'
param applicationVnetName string = '${prefix}-vnet'
param applicationNsgName string = '${prefix}-private-nsg'
param tenantId string
param clientId string
@minLength(1)
param allowedPrincipalIds array
@secure()
param clientSecret string
@secure()
param backendCaPem string
@description('Reviewed official nginx image pinned by SHA-256, never a moving tag.')
param gatewayImage string
@description('Complete nginx config, generated by scripts/azure/browser_access.py.')
@secure()
param nginxConfig string

resource applicationVnet 'Microsoft.Network/virtualNetworks@2024-05-01' existing = {
  name: applicationVnetName
}
resource applicationNsg 'Microsoft.Network/networkSecurityGroups@2024-05-01' existing = {
  name: applicationNsgName
}
resource gatewayVnet 'Microsoft.Network/virtualNetworks@2024-05-01' = {
  name: '${prefix}-browser-vnet'
  location: location
  properties: {
    addressSpace: { addressPrefixes: ['10.43.0.0/16'] }
    subnets: [{
      name: 'gateway'
      properties: {
        addressPrefix: '10.43.0.0/23'
        delegations: [{
          name: 'container-apps'
          properties: { serviceName: 'Microsoft.App/environments' }
        }]
      }
    }]
  }
}
resource outboundPeering 'Microsoft.Network/virtualNetworks/virtualNetworkPeerings@2024-05-01' = {
  parent: gatewayVnet
  name: 'application'
  properties: {
    remoteVirtualNetwork: { id: applicationVnet.id }
    allowVirtualNetworkAccess: true
    allowForwardedTraffic: false
    allowGatewayTransit: false
    useRemoteGateways: false
  }
}
resource inboundPeering 'Microsoft.Network/virtualNetworks/virtualNetworkPeerings@2024-05-01' = {
  parent: applicationVnet
  name: 'browser-gateway'
  properties: {
    remoteVirtualNetwork: { id: gatewayVnet.id }
    allowVirtualNetworkAccess: true
    allowForwardedTraffic: false
    allowGatewayTransit: false
    useRemoteGateways: false
  }
}
resource backendRule 'Microsoft.Network/networkSecurityGroups/securityRules@2024-05-01' = {
  parent: applicationNsg
  name: 'AppFromBrowserGateway'
  properties: {
    priority: 120
    direction: 'Inbound'
    access: 'Allow'
    protocol: 'Tcp'
    sourceAddressPrefix: '10.43.0.0/23'
    sourcePortRange: '*'
    destinationAddressPrefix: '10.42.1.4/32'
    destinationPortRange: '8765'
  }
}
resource managedEnvironment 'Microsoft.App/managedEnvironments@2025-07-01' = {
  name: '${prefix}-browser-env'
  location: location
  properties: {
    workloadProfiles: [{ name: 'Consumption', workloadProfileType: 'Consumption' }]
    vnetConfiguration: {
      infrastructureSubnetId: '${gatewayVnet.id}/subnets/gateway'
      internal: false
    }
    appLogsConfiguration: {}
  }
}
resource gateway 'Microsoft.App/containerApps@2025-07-01' = {
  name: '${prefix}-browser'
  location: location
  properties: {
    environmentId: managedEnvironment.id
    workloadProfileName: 'Consumption'
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: {
        external: false
        allowInsecure: false
        targetPort: 8080
        transport: 'http'
      }
      secrets: [
        { name: 'entra-client-secret', value: clientSecret }
        { name: 'backend-ca', value: backendCaPem }
        { name: 'nginx-config', value: nginxConfig }
      ]
    }
    template: {
      containers: [{
        name: 'browser-gateway'
        image: gatewayImage
        command: ['nginx']
        args: ['-c', '/etc/centerek/nginx.conf', '-g', 'daemon off;']
        resources: { cpu: json('0.25'), memory: '0.5Gi' }
        volumeMounts: [{ volumeName: 'configuration', mountPath: '/etc/centerek' }]
        probes: [{
          type: 'Readiness'
          tcpSocket: { port: 8080 }
          initialDelaySeconds: 2
          periodSeconds: 5
        }]
      }]
      volumes: [{
        name: 'configuration'
        storageType: 'Secret'
        secrets: [
          { secretRef: 'backend-ca', path: 'backend-ca.pem' }
          { secretRef: 'nginx-config', path: 'nginx.conf' }
        ]
      }]
      scale: {
        minReplicas: 0
        maxReplicas: 1
        rules: [{ name: 'http', http: { metadata: { concurrentRequests: '20' } } }]
      }
    }
  }
  dependsOn: [outboundPeering, inboundPeering, backendRule]
}
resource authentication 'Microsoft.App/containerApps/authConfigs@2025-07-01' = {
  parent: gateway
  name: 'current'
  properties: {
    platform: { enabled: true }
    globalValidation: {
      unauthenticatedClientAction: 'RedirectToLoginPage'
      redirectToProvider: 'azureActiveDirectory'
      excludedPaths: []
    }
    httpSettings: { requireHttps: true }
    identityProviders: {
      azureActiveDirectory: {
        enabled: true
        registration: {
          clientId: clientId
          clientSecretSettingName: 'entra-client-secret'
          openIdIssuer: '${environment().authentication.loginEndpoint}${tenantId}/v2.0'
        }
        validation: {
          allowedAudiences: [clientId]
          defaultAuthorizationPolicy: {
            allowedPrincipals: { identities: allowedPrincipalIds }
          }
        }
      }
    }
    login: {
      preserveUrlFragmentsForLogins: false
      allowedExternalRedirectUrls: []
      cookieExpiration: { convention: 'FixedTime', timeToExpiration: '08:00:00' }
    }
  }
}

output gatewayId string = gateway.id
output origin string = 'https://${gateway.properties.configuration.ingress.fqdn}'
output externalIngressEnabled bool = false
